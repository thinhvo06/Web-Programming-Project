# CẤU HÌNH KẾT NỐI FRONTEND & BACKEND (DÀNH CHO THÀNH VIÊN 2)
# Khi bạn làm Backend đã dựng API và WebSocket xong:
# 1. Đổi VITE_USE_MOCK=false
# 2. Cập nhật URL server Backend và WebSocket tương ứng

# Bật (false) hoặc Tắt (true) chế độ Mock dữ liệu tạm thời
VITE_USE_MOCK=true

# Địa chỉ RESTful API Backend
VITE_API_URL=http://localhost:5000/api

# Địa chỉ WebSocket (Socket.io) Realtime Collaboration
VITE_SOCKET_URL=http://localhost:5000
